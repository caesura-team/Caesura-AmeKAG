# Auto-detect text files, normalize to LF in repo, CRLF on Windows checkout
* text=auto

# Source code
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.lua text eol=lf
*.hlsl text eol=lf
*.sc text eol=lf
*.metal text eol=lf
*.cmake text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
# Preserve historical producer inputs and captured bytes exactly on every host.
tests/golden_saves/release-v1.0.1-*.json -text whitespace=cr-at-eol
tests/projects/u11_legacy_release/story.ks -text whitespace=cr-at-eol
*.bat text eol=crlf
*.sh text eol=lf
*.desktop text eol=lf

# Binary
*.dxbc binary
*.png binary
*.jpg binary
*.ttf binary
*.carc binary
*.mp3 binary
*.ogg binary
*.wav binary
