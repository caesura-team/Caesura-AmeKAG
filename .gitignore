# Auto-generated editor RPC bearer token (EditorServer writes it when
# CAESURA_EDITOR_TOKEN is unset). It is a live credential — never commit it.
.caesura-editor-token

# Agent probe scratch files (convergence cleanup: agents may leave
# one-off scan/probe scripts; never commit them)
/*_probe.lua
/*_tmp.lua
/tmp_probe*.lua
/ks_scan_tmp.lua
/ks_*_proto.lua
tests/scripts/tmp_probe*.lua
web/scratch.*.test.js
editor/.scratch_*
cache/

# Steamworks SDK (proprietary, manual download -- same pattern as Live2D)
steamworks_sdk_*.zip
external/steamworks/
steam_appid.txt

# PM-created projects (user content)
projects/*
!projects/.gitkeep
