{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caesura.engine/schemas/validation-evidence.v1.json",
  "title": "Caesura collected execution evidence v1",
  "description": "Structural schema only. Release verification additionally reparses original reports and compares a separately trusted executor receipt and profile. This document cannot grant publication approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "profile_name", "profile_sha256", "receipt_sha256", "context", "result", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "caesura-validation-evidence"},
    "profile_name": {"$ref": "#/$defs/id"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"enum": ["PASS", "FAIL"]},
    "context": {"$ref": "#/$defs/context"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time"},
    "context": {
      "type": "object",
      "required": ["schema_version", "profile_name", "source_sha", "dirty", "worktree_fingerprint", "finished_worktree_fingerprint", "source_changed_during_run", "fixture_sha256", "finished_fixture_sha256", "fixtures_changed_during_run", "profile_sha256", "purpose", "run_id", "run_attempt", "repository", "workflow", "platform", "configuration", "started_at", "finished_at", "toolchain"],
      "properties": {
        "schema_version": {"const": 1},
        "profile_name": {"$ref": "#/$defs/id"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "worktree_fingerprint": {"$ref": "#/$defs/sha256"},
        "finished_worktree_fingerprint": {"$ref": "#/$defs/sha256"},
        "source_changed_during_run": {"type": "boolean"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "finished_fixture_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "fixtures_changed_during_run": {"type": "boolean"},
        "fixture_error": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"enum": ["validation", "test-fixture"]},
        "run_id": {"$ref": "#/$defs/id"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "repository": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "started_at": {"$ref": "#/$defs/time"},
        "finished_at": {"$ref": "#/$defs/time"},
        "toolchain": {"type": "object", "minProperties": 1},
        "profile_variables": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "allOf": [{
        "if": {"properties": {"finished_fixture_sha256": {"type": "null"}}},
        "then": {"required": ["fixture_error"], "properties": {"fixtures_changed_during_run": {"const": true}}},
        "else": {"not": {"required": ["fixture_error"]}}
      }]
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^inputs/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}/(stdout|stderr|report|binary|executed_program)$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["discovered", "executed", "passed", "failed", "skipped"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "sanitizer_capture": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "complete", "directory", "prefix", "options_contract", "files"],
      "properties": {
        "version": {"const": 1},
        "complete": {"const": true},
        "directory": {"type": "string", "pattern": "^inputs/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}/sanitizer$"},
        "prefix": {"const": "sanitizer"},
        "options_contract": {"const": "llvm-common-log-path-v1"},
        "files": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string", "pattern": "^inputs/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}/sanitizer/sanitizer\\.[1-9][0-9]*$"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "size_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
            }
          }
        }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parser", "required", "result", "reasons"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parser": {"enum": ["doctest", "lua", "ctest-junit", "vitest-json", "unittest", "exit-code"]},
        "required": {"type": "boolean"},
        "result": {"enum": ["PASS", "FAIL", "SKIP", "NOT_RUN", "NOT_APPLICABLE"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "started_at": {"$ref": "#/$defs/time"},
        "finished_at": {"$ref": "#/$defs/time"},
        "exit_code": {"type": "integer"},
        "counts": {"$ref": "#/$defs/counts"},
        "skipped_tests": {"type": "array", "items": {"type": "string"}},
        "sanitizer_capture": {"$ref": "#/$defs/sanitizer_capture"},
        "files": {
          "type": "object", "additionalProperties": false,
          "required": ["stdout", "stderr"],
          "properties": {
            "stdout": {"$ref": "#/$defs/file"},
            "stderr": {"$ref": "#/$defs/file"},
            "report": {"$ref": "#/$defs/file"},
            "binary": {"$ref": "#/$defs/file"},
            "executed_program": {"$ref": "#/$defs/file"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"result": {"enum": ["PASS", "FAIL", "SKIP"]}}},
        "then": {"required": ["command", "cwd", "started_at", "finished_at", "exit_code", "counts", "skipped_tests", "files"]}
      }, {
        "if": {"required": ["exit_code"], "properties": {"exit_code": {"const": 0}}},
        "then": {"properties": {"files": {"required": ["executed_program"]}}}
      }]
    }
  }
}
